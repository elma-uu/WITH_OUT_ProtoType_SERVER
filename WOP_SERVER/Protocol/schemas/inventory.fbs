namespace ProtoType.Net;

// One placed item in the grid inventory. item_id is the item Data Asset's
// own object name (e.g. "DA_Item_AK47") -- not UItemDataBase::ItemId, which
// isn't guaranteed to actually be filled in by content authors; the asset
// name always exists and is unique.
table InventoryItemEntry {
  item_id: string;
  grid_x: short = 0;
  grid_y: short = 0;
  rotated: bool = false;
  stack_count: short = 1;
}

// Sent by the client whenever its inventory grid changes (add/remove/move/
// rotate/split/merge) -- always the FULL current contents, not a diff, so
// the server's stored copy can never drift out of sync from a dropped
// packet. No reply; the client is the source of truth while connected.
table C2S_SaveInventory {
  items: [InventoryItemEntry];
}

// One equipped item -- EEquipmentSlot as a plain ubyte
// (0=Helmet/1=Vest/2=Weapon1/3=Weapon2) so this schema doesn't need to know
// about the client's C++ enum. item_id is the item Data Asset's own object
// name, same convention as InventoryItemEntry.item_id.
table EquipmentItemEntry {
  slot: ubyte;
  item_id: string;
}

// Same "always full contents, not a diff" contract as C2S_SaveInventory,
// for UEquipmentComponent's own separate (not grid-based) storage. No reply.
table C2S_SaveEquipment {
  items: [EquipmentItemEntry];
}

// One quick-slot assignment. item_id is the item Data Asset's own object
// name, same convention as InventoryItemEntry.item_id.
table QuickSlotItemEntry {
  slot_index: ubyte;
  item_id: string;
  stack_count: short = 1;
}

// Same "always full contents, not a diff" contract as C2S_SaveInventory,
// for UQuickSlotComponent's own separate (not grid-based) storage. No reply.
table C2S_SaveQuickSlots {
  items: [QuickSlotItemEntry];
}

// Requests this account's saved SafePlace stash (dbo.PlayerStash) -- sent by
// AStorageContainer::BeginPlay so the box is populated before the player
// even opens it. Answered with S2C_StashState, unicast to the requester only
// (this is per-account data, not something other players should see about
// each other -- unlike a loot container's shared, world-visible contents).
// Silently ignored for guest (non-account) sessions, same trust tier as
// C2S_SaveInventory. stash_index distinguishes independent stashes for the
// same account (e.g. two placed AStorageContainer boxes in SafePlace --
// AStorageContainer::StashIndex, "1"/"2" in the level, 0/1 on the wire) --
// see 문제점09-12.txt #7 "창고 두개 1 2".
table C2S_RequestStash {
  stash_index: ubyte = 0;
}

// Reply to C2S_RequestStash, and also sent whenever this account's stash
// changes are saved (so multiple SafePlace instances -- e.g. reconnecting --
// see a consistent view). Reuses InventoryItemEntry: each stash is a grid
// exactly like the player's own inventory, just stored under a different
// table (dbo.PlayerStash) and keyed by (AccountId, stash_index) instead of
// being carried on the character. stash_index echoes which stash this is,
// so AStorageContainer can tell its own reply apart from its sibling box's
// (every box in the level shares this one broadcast delegate -- same
// "filter by id" reasoning as OnContainerLootState's ContainerId).
table S2C_StashState {
  stash_index: ubyte = 0;
  items: [InventoryItemEntry];
}

// Same "always full contents, not a diff" contract as C2S_SaveInventory --
// sent whenever one of the player's SafePlace stash grids changes. No reply
// (the client is the source of truth for its own just-made edit); silently
// ignored for guest sessions. stash_index: see C2S_RequestStash's comment.
table C2S_SaveStash {
  stash_index: ubyte = 0;
  items: [InventoryItemEntry];
}
