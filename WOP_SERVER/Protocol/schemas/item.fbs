include "common.fbs";
include "inventory.fbs";

namespace ProtoType.Net;

enum ItemUseType : byte {
  Consume,
  Equip,
  Unequip,
  Drop,
  Reload,
  Inspect,
  ToggleAttachment,
}

table C2S_ItemUseRequest {
  header: Header;
  item_instance_id: uint64;
  slot: ubyte;
  use_type: ItemUseType;
}

table S2C_ItemUseResult {
  player_id: uint32;
  item_instance_id: uint64;
  use_type: ItemUseType;
  result: ResultCode;
  value: float;
}

// Relayed to every other connected client so they can mirror the action.
// Broadcast for every use_type; the client decides what to do with each
// (currently: Reload plays the reload montage, Equip switches the held
// weapon). slot doubles as the acting player's weapon type (EWeaponType)
// for both of those, so the receiver knows which weapon/animation it's for.
table S2C_ItemUseBroadcast {
  user_id: uint32;
  use_type: ItemUseType;
  slot: ubyte;
}

// Reported by a client the first time it BeginPlays into a placed
// ALootContainer this session, carrying whatever random roll it generated
// locally for that container's contents (see ALootContainer::SeedContents).
// The server keeps only the first roll it sees per container_id (see
// EchoServer::ClaimContainerLoot) and echoes that back to EVERY connected
// client -- including the reporter -- as the one true answer, so nobody
// ends up seeing different contents in the same box. container_id is a
// hash of the placed actor's stable in-level name, not something the
// server assigns; see AItemContainerBase::GetContainerId.
table C2S_ContainerLootRoll {
  container_id: uint32;
  items: [InventoryItemEntry];
}

// The authoritative contents for container_id -- either the reporting
// client's own roll (if it was first) or whatever was already stored.
table S2C_ContainerLootState {
  container_id: uint32;
  items: [InventoryItemEntry];
}

// One loose item dropped in the open world by an AItemSpawnPoint's roll --
// not a grid slot (see InventoryItemEntry for that), a fixed world
// position instead. stack_count mirrors AItemSpawnPoint::SpawnLoot's drops
// (always 1 today, included for forward-compat).
table WorldSpawnedItemEntry {
  item_id: string;
  position: Vec3;
  stack_count: short = 1;
}

// Same first-roll-wins idea as C2S_ContainerLootRoll, for a placed
// AItemSpawnPoint's scattered world drops instead of a grid container's
// contents -- reported once, right after it rolls its own loot locally.
// spawn_point_id is a hash of the placed actor's stable in-level name,
// same convention as container_id/enemy_id.
table C2S_ItemSpawnRoll {
  spawn_point_id: uint32;
  items: [WorldSpawnedItemEntry];
}

// The authoritative scattered drops for spawn_point_id -- either the
// reporting client's own roll (if it was first) or whatever was already
// stored. Echoed back to EVERY connected client, including the reporter.
table S2C_ItemSpawnState {
  spawn_point_id: uint32;
  items: [WorldSpawnedItemEntry];
}
