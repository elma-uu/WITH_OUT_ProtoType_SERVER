include "common.fbs";

namespace ProtoType.Net;

enum ItemUseType : byte {
  Consume,
  Equip,
  Unequip,
  Drop,
  Reload,
  Inspect,
  ToggleAttachment,
}

table C2S_ItemUseRequest {
  header: Header;
  item_instance_id: uint64;
  slot: ubyte;
  use_type: ItemUseType;
}

table S2C_ItemUseResult {
  player_id: uint32;
  item_instance_id: uint64;
  use_type: ItemUseType;
  result: ResultCode;
  value: float;
}

// Relayed to every other connected client so they can mirror the action
// (currently used for reload motion); slot doubles as the acting player's
// weapon type (EWeaponType) for reload so the receiver knows which reload
// animation section to play.
table S2C_ItemUseBroadcast {
  user_id: uint32;
  use_type: ItemUseType;
  slot: ubyte;
}
