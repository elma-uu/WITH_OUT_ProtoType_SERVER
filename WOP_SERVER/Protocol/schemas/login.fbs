include "common.fbs";
include "inventory.fbs";

namespace ProtoType.Net;

table C2S_Login {
  auth_token: string;
  client_version: string;
  // Account credentials against the server's MSSQL Accounts table.
  username: string;
  password: string;
  // false (default): login -- username must already exist, password must
  // match (else S2C_LoginFail{AccountNotFound} / {InvalidToken}).
  // true: register -- username must NOT already exist (else
  // S2C_LoginFail{UsernameTaken}), creates a brand new account.
  is_register: bool;
}

enum LoginFailReason : byte {
  InvalidToken,
  VersionMismatch,
  ServerFull,
  Banned,
  AlreadyLoggedIn,
  Unknown,
  // Login attempted (is_register=false) against a username with no account.
  AccountNotFound,
  // Register attempted (is_register=true) against a username that's already taken.
  UsernameTaken,
}

table S2C_LoginFail {
  reason: LoginFailReason;
  message: string;
}

table S2C_LoginSuccess {
  player_id: uint32;
  // Restored from the account's saved PlayerProgress row, if any (see
  // has_saved_progress); otherwise these are unset and the client keeps
  // its normal deterministic spawn behavior.
  position: Vec3;
  look: Rotator;
  weapon_type: ubyte;
  has_saved_progress: bool;
  // Restored grid inventory contents, same lifecycle as has_saved_progress
  // (empty if the account never saved one).
  inventory: [InventoryItemEntry];
}
