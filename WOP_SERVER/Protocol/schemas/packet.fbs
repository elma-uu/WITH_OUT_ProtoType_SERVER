include "login.fbs";
include "player.fbs";
include "movement.fbs";
include "attack.fbs";
include "item.fbs";
include "interact.fbs";
include "inventory.fbs";
include "companion.fbs";
include "enemy.fbs";

namespace ProtoType.Net;

union Payload {
  C2S_Login,
  S2C_LoginFail,
  S2C_LoginSuccess,
  S2C_SendAvatarInfo,
  S2C_SendPlayerInfo,
  S2C_PlayerLeft,
  C2S_MoveInput,
  S2C_MoveState,
  C2S_AttackRequest,
  S2C_AttackResult,
  S2C_AttackBroadcast,
  C2S_ItemUseRequest,
  S2C_ItemUseResult,
  S2C_ItemUseBroadcast,
  C2S_InteractRequest,
  S2C_InteractResult,
  C2S_SaveInventory,
  C2S_SetVisible,
  C2S_ContainerLootRoll,
  S2C_ContainerLootState,
  C2S_CompanionMoveInput,
  S2C_CompanionMoveState,
  C2S_EnemyClaimRequest,
  S2C_EnemyClaimResult,
  C2S_EnemyState,
  S2C_EnemyState,
  S2C_EnemyOwnerLeft,
  C2S_EnemyDamage,
  S2C_EnemyDamage,
  C2S_EnemyRegister,
}

table Packet {
  payload: Payload;
}

root_type Packet;
file_identifier "PTPK";
