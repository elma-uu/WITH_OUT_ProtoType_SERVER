include "common.fbs";

namespace ProtoType.Net;

enum EquipSlot : byte {
  Head,
  Chest,
  Back,
  Hands,
  Legs,
  Feet,
  PrimaryWeapon,
  SecondaryWeapon,
  Melee,
}

table EquippedVisual {
  slot: EquipSlot;
  item_id: uint32;
}

table S2C_SendAvatarInfo {
  player_id: uint32;
  nickname: string;
  position: Vec3;
  look: Rotator;
  health: float;
  max_health: float;
  level: uint32;
  character_model_id: uint32;
  equipped: [EquippedVisual];
}

table S2C_SendPlayerInfo {
  player_id: uint32;
  nickname: string;
  position: Vec3;
  look: Rotator;
  character_model_id: uint32;
  equipped: [EquippedVisual];
}

// Broadcast to every remaining client when a player disconnects, so they can
// despawn that player's remote actor instead of leaving a frozen ghost.
table S2C_PlayerLeft {
  player_id: uint32;
}

// Sent when entering/leaving a Single map (see
// UProtoNetClientSubsystem::SetMultiplayerVisualsEnabled) -- the session
// stays connected (still logged in, still saving progress) but stops
// sending C2S_MoveInput/etc, so without this, other clients would just see
// this player's last known position freeze instead of properly leaving.
// visible=false makes the server broadcast S2C_PlayerLeft on this session's
// behalf (without actually closing it); visible=true needs no reply -- the
// next C2S_MoveInput this session sends once back in a Multi map naturally
// respawns it on everyone else's screen the same way any new player does.
table C2S_SetVisible {
  visible: bool;
}

// Sent once by a client whose local player just died (StatusComponent's
// OnPlayerDied fired -- see AProtoCharacter::HandleDeath), so the server
// can broadcast it to every OTHER client. No fields: player_id is always
// this session's own id, same "server decides, not the client" rule
// C2S_MoveInput follows for its own position.
table C2S_PlayerDied {
}

// Broadcast to every OTHER client. Purely visual on the receiving end --
// ragdoll this player's remote mirror instead of leaving it standing
// frozen (see AProtoCharacter::HandleRemotePlayerDied). Health itself
// isn't server-authoritative yet (see that function's comment), so this
// is trusted the same way C2S_AttackRequest's gun damage already is: the
// dying client's own client decided it died, the server just relays it.
table S2C_PlayerDied {
  player_id: uint32;
}
