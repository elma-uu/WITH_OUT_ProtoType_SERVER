include "common.fbs";
include "item.fbs";

namespace ProtoType.Net;

enum EquipSlot : byte {
  Head,
  Chest,
  Back,
  Hands,
  Legs,
  Feet,
  PrimaryWeapon,
  SecondaryWeapon,
  Melee,
}

table EquippedVisual {
  slot: EquipSlot;
  item_id: uint32;
}

table S2C_SendAvatarInfo {
  player_id: uint32;
  nickname: string;
  position: Vec3;
  look: Rotator;
  health: float;
  max_health: float;
  level: uint32;
  character_model_id: uint32;
  equipped: [EquippedVisual];
}

table S2C_SendPlayerInfo {
  player_id: uint32;
  nickname: string;
  position: Vec3;
  look: Rotator;
  character_model_id: uint32;
  equipped: [EquippedVisual];
}

// Broadcast to every remaining client when a player disconnects, so they can
// despawn that player's remote actor instead of leaving a frozen ghost.
table S2C_PlayerLeft {
  player_id: uint32;
}

// Sent when entering/leaving a Single map (see
// UProtoNetClientSubsystem::SetMultiplayerVisualsEnabled) -- the session
// stays connected (still logged in, still saving progress) but stops
// sending C2S_MoveInput/etc, so without this, other clients would just see
// this player's last known position freeze instead of properly leaving.
// visible=false makes the server broadcast S2C_PlayerLeft on this session's
// behalf (without actually closing it); visible=true needs no reply -- the
// next C2S_MoveInput this session sends once back in a Multi map naturally
// respawns it on everyone else's screen the same way any new player does.
table C2S_SetVisible {
  visible: bool;
}

// Sent once by a client whose local player just died (StatusComponent's
// OnPlayerDied fired -- see AProtoCharacter::HandleDeath), so the server
// can broadcast it to every OTHER client. player_id is always this
// session's own id, same "server decides, not the client" rule
// C2S_MoveInput follows for its own position -- only items needs to come
// from the client at all. items is this player's full carried loadout
// (grid inventory + equipment + quick slots, all about to be wiped by
// WipeCarriedInventoryOnDeath) with each entry's position already computed
// client-side (scattered around the death location) -- see
// AProtoCharacter::BuildDeathDropSnapshot. Reusing WorldSpawnedItemEntry
// (the same shape AItemSpawnPoint's scattered drops use) rather than
// InventoryItemEntry since these are world-placed drops, not grid slots.
table C2S_PlayerDied {
  items: [WorldSpawnedItemEntry];
}

// Broadcast to every OTHER client. Purely visual on the receiving end --
// ragdoll this player's remote mirror instead of leaving it standing
// frozen (see AProtoCharacter::HandleRemotePlayerDied), AND spawn the same
// ADropItem pile items describes (see AProtoCharacter::SpawnDeathDropItems)
// so teammates can loot what this player was carrying. Health itself
// isn't server-authoritative yet (see that function's comment), so this
// is trusted the same way C2S_AttackRequest's gun damage already is: the
// dying client's own client decided it died, the server just relays it --
// items is a pure relay of whatever C2S_PlayerDied.items said, unmodified.
table S2C_PlayerDied {
  player_id: uint32;
  items: [WorldSpawnedItemEntry];
}

// 문제: "먼저 들어온 사람 화면에서 늦게 들어온 유저가 안 보임" -- Room::
// AnnounceNewMember의 원래 로스터 알림은 이 세션이 Room 멤버로 추가되는 그
// 순간(레벨이 아직 로딩 중일 수도 있는 시점) 딱 한 번만 나간다. 그 한 번을
// 놓치면(레벨 전환 도중이라 처리가 밀렸다거나 등) 다시 알려줄 방법이 없었다.
// 이 메시지는 클라이언트가 실제로 멀티맵 레벨을 다 불러오고 플레이 가능한
// 상태가 된 "이제 진짜 준비됐다" 시점에 보내는 것 -- 서버는 이 세션과 이
// Room의 다른 모든 멤버 양쪽에게 서로의 로스터 정보를 다시 브로드캐스트해서
// (Room::ReannounceMember), 원래 알림을 놓쳤어도 여기서 자체 복구된다.
table C2S_MultiMapReady {
}
